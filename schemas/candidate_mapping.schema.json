{
  "type": "object",
  "required": [
    "line_id",
    "source_part_id",
    "resolved_part_id",
    "available_pins",
    "candidates"
  ],
  "properties": {
    "line_id": {
      "type": "string"
    },
    "source_part_id": {
      "type": "string"
    },
    "resolved_part_id": {
      "type": "string",
      "description": "兼容前导零后匹配到的 pin_info 实际 key。"
    },
    "source_block_id": {
      "type": "string"
    },
    "source_port": {
      "type": "string"
    },
    "target_block_name": {
      "type": "string"
    },
    "target_port": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "INPUT",
        "OUTPUT",
        ""
      ]
    },
    "expansion_index": {
      "type": "integer"
    },
    "expansion_count": {
      "type": "integer"
    },
    "available_pins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pin",
          "score",
          "basis"
        ],
        "properties": {
          "pin": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
