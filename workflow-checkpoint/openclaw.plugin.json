{
  "id": "workflow-checkpoint",
  "name": "Workflow Checkpoint",
  "description": "Durable workflow stage boundaries and same-session continuation.",
  "activation": { "onStartup": true, "onCapabilities": ["tool"] },
  "contracts": { "tools": ["workflow_checkpoint"] },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "workflows": { "type": "object", "additionalProperties": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
      } }
    }
  }
}
